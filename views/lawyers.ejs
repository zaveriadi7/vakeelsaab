<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registered Lawyers</title>
  
  <style>
    /* Global Reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background-color: #f4f7fa;
  margin: 0;
  padding: 20px;
}

h1 {
  text-align: center;
  color: #333;
  margin-bottom: 20px;
}

/* Container for the table */
.table-container {
  max-width: 90%;
  margin: 0 auto;
  background-color: #fff;
  border-radius: 8px;
  box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
  padding: 20px;
  overflow-x: auto;
}

/* Table Styles */
table {
  width: 100%;
  border-collapse: collapse;
  margin: 20px 0;
  table-layout: auto;
}

th, td {
  padding: 12px 20px;
  text-align: left;
  border-bottom: 1px solid #ddd;
}

th {
  background-color: #007bff;
  color: white;
}

tr:hover {
  background-color: #f1f1f1;
}

td button {
  background-color: #dc3545;
  color: white;
  padding: 6px 12px;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

td button:hover {
  background-color: #c82333;
}

/* No lawyers message */
p {
  text-align: center;
  font-size: 18px;
  color: #777;
}
  </style>
</head>
<body>

  <h1>Registered Lawyers</h1>
  
  <% if (lawyers.length > 0) { %>
    <table border="1">
      <thead>
        <tr>
          <th>ID</th>
          <th>First Name</th>
          <th>Last Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Specialization</th>
          <th>License Number</th>
          <th>License Expiry</th>
          <th>City</th>
          <th>State</th>
          <th>Country</th>
          <th>Action</th> <!-- Add action column for delete button -->
        </tr>
      </thead>
      <tbody>
        <% lawyers.forEach(lawyer => { %>
          <tr>
            <td><%= lawyer.id %></td>
            <td><%= lawyer.first_name %></td>
            <td><%= lawyer.last_name %></td>
            <td><%= lawyer.email %></td>
            <td><%= lawyer.phone %></td>
            <td><%= lawyer.specialization %></td>
            <td><%= lawyer.license_number %></td>
            <td><%= lawyer.license_expiry %></td>
            <td><%= lawyer.city %></td>
            <td><%= lawyer.state %></td>
            <td><%= lawyer.country %></td>
            <td>
              <!-- Delete button that sends a request to delete using the phone number -->
              <form action="/lawyers/delete" method="POST" style="display:inline;">
                <input type="hidden" name="phone" value="<%= lawyer.phone %>">
                <button type="submit" onclick="return confirm('Are you sure you want to delete this lawyer?')">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p>No lawyers found.</p>
  <% } %>

</body>
</html>